<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_toruq_salla" model="ir.module.category">
        <field name="name">Salla</field>
        <field name="sequence">55</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">Salla User</field>
        <field name="category_id" ref="module_category_toruq_salla"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Salla Manager</field>
        <field name="category_id" ref="module_category_toruq_salla"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_store_company" model="ir.rule">
        <field name="name">Salla store: multi-company</field>
        <field name="model_id" ref="model_toruq_salla_store"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_product_map_company" model="ir.rule">
        <field name="name">Salla product link: multi-company</field>
        <field name="model_id" ref="model_toruq_salla_product"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_event_company" model="ir.rule">
        <field name="name">Salla event: multi-company</field>
        <field name="model_id" ref="model_toruq_salla_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">toruq.salla.event.list</field>
        <field name="model">toruq.salla.event</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-muted="state in ('done', 'ignored')" create="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" groups="toruq_salla.group_manager"/>
                </header>
                <field name="received_at"/>
                <field name="store_id" optional="hide"/>
                <field name="event"/>
                <field name="order_ref"/>
                <field name="sale_order_id" optional="show"/>
                <field name="attempts" optional="show"/>
                <field name="error" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_event_form" model="ir.ui.view">
        <field name="name">toruq.salla.event.form</field>
        <field name="model">toruq.salla.event</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="state not in ('failed', 'pending')" groups="toruq_salla.group_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="event"/>
                            <field name="order_ref"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                            <field name="attempts"/>
                            <field name="next_try"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_event_search" model="ir.ui.view">
        <field name="name">toruq.salla.event.search</field>
        <field name="model">toruq.salla.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event"/>
                <field name="order_ref"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_event" model="ir.actions.act_window">
        <field name="name">Salla Events Log</field>
        <field name="res_model">toruq.salla.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

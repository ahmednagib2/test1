<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_toruq_stock_view" model="ir.ui.view">
        <field name="name">product.template.toruq.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salla Reserve" name="toruq_salla_reserve">
                    <group>
                        <field name="toruq_use_custom_reserve"/>
                        <field name="toruq_reserve_qty" invisible="not toruq_use_custom_reserve"/>
                        <field name="toruq_salla_qty"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
